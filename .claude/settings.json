{
    "enabledPlugins": {
        "frontend-design@claude-plugins-official": true
    },
    "enabledMcpjsonServers": ["shadcn"],
    "permissions": {
        "deny": ["Read(./.env)", "Read(./.env.*)"]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "npm run typecheck --silent 1>&2 || exit 2"
                    }
                ]
            }
        ]
    }
}
