# Copy to .env.local and fill in. Never commit real values.

# --- Database (MongoDB Atlas) ---
MONGODB_URI=

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Google OAuth client. Redirect URI (dev): http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- First admin account, created by `npm run seed` ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Cloudinary (poster / video) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI (see src/ai) ---
# anthropic | gemini  (default provider; can be overridden by systemSettings)
AI_PROVIDER=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
